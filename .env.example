# ====================================================================
# CẤU HÌNH HỆ THỐNG MINT PHARMA - QUẢN LÝ HÓA ĐƠN LÔ THUỐC
# Sao chép file này thành file `.env` và điền thông tin thực tế của bạn.
# TUYỆT ĐỐI KHÔNG commit file `.env` chứa mật khẩu thật lên Git/GitHub.
# ====================================================================

# 1. CẤU HÌNH MYSQL SERVER
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=HoaDonLoThuoc
DB_USER=root
DB_PASSWORD=tp785

# 2. CẤU HÌNH BACKEND SERVER
PORT=5000
HOST=0.0.0.0

# 3. CẤU HÌNH ĐỒNG BỘ GOOGLE SHEETS (SECTION 9)
# Đổi thành true khi bạn đã triển khai Google Apps Script
GOOGLE_SHEETS_SYNC_ENABLED=false

# URL Web App được tạo từ Google Apps Script của bảng tính
# Ví dụ: https://script.google.com/macros/s/AKfycbx.../exec
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyYx_4B6A-draffAKD4Gs9JsKxayVhQ85ILJKgK4VrPjTCrs4yxRSIRupL4r9z1bco/exec
# Khóa bí mật (Secret Token) để xác thực an toàn giữa Backend và Google Apps Script
SHEETS_SYNC_SECRET=mint_pharma_secure_sync_secret_token_2026
