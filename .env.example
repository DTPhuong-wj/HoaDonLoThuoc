# ====================================================================
# CẤU HÌNH HỆ THỐNG MINT PHARMA - QUẢN LÝ HÓA ĐƠN LÔ THUỐC
# Sao chép file này thành file `.env` và điền thông tin thực tế của bạn.
# TUYỆT ĐỐI KHÔNG commit file `.env` chứa mật khẩu thật lên Git/GitHub.
# ====================================================================

# --------------------------------------------------------------------
# 1. CẤU HÌNH MYSQL SERVER (CHỌN CÁCH 1 HOẶC CÁCH 2)
# --------------------------------------------------------------------
# Cách 1: Sử dụng chuỗi kết nối duy nhất (Khuyên dùng khi triển khai Cloud MySQL như Aiven, TiDB, Railway)
# DATABASE_URL=mysql://avnadmin:AVNS_xxxx@mysql-xxxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Cách 2: Sử dụng các biến kết nối riêng lẻ (Mặc định cho Local MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=HoaDonLoThuoc
DB_USER=root
DB_PASSWORD=

# Bật SSL cho kết nối MySQL (BẮT BUỘC là true khi kết nối Cloud MySQL qua Internet)
DB_SSL=false

# --------------------------------------------------------------------
# 2. CẤU HÌNH BACKEND SERVER
# --------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
# Tên miền cho phép gọi API (Để '*' cho phép tất cả, hoặc điền domain Cloudflare Pages của bạn)
CORS_ORIGIN=*

# --------------------------------------------------------------------
# 3. CẤU HÌNH FRONTEND BUILD (CLOUDFLARE PAGES)
# --------------------------------------------------------------------
# Điền URL công khai của Backend Cloud khi build Frontend (Nếu để trống, frontend mặc định gọi /api)
# VITE_API_URL=https://hoadonlothuoc-api.onrender.com/api

# --------------------------------------------------------------------
# 4. CẤU HÌNH ĐỒNG BỘ HAI CHIỀU GOOGLE SHEETS
# --------------------------------------------------------------------
GOOGLE_SHEETS_SYNC_ENABLED=true
# URL Web App từ Google Apps Script
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec
# Khóa bí mật xác thực an toàn giữa Backend Cloud và Google Apps Script
SHEETS_SYNC_SECRET=mint_pharma_secure_sync_secret_token_2026
